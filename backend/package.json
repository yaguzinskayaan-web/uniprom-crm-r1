{
  "name": "uniprom-crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "UNIPROM CRM R1 — backend (API) per ТЗ Унипром CRM v2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "db:reset": "prisma db push --force-reset --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx tests/smoke.ts",
    "test": "node --test --import tsx tests/*.test.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:list": "tsx scripts/backup.ts list",
    "migrate:snapshot": "tsx scripts/migrate-check.ts before",
    "migrate:verify": "tsx scripts/migrate-check.ts after",
    "migrate:compare": "tsx scripts/migrate-check.ts compare",
    "loadtest": "tsx scripts/loadtest.ts",
    "test:cleanup": "tsx scripts/cleanup-test-applications.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.1.0",
    "@types/pdfkit": "^0.13.8",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
