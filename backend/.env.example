# Шаблон окружения backend. Скопируйте в .env и замените значения под своё окружение.

# --- База данных и приложение ---------------------------------------------
DATABASE_URL="file:./prisma/crm.db"
# Обязателен в production: не короче 32 символов.
JWT_SECRET="dev-only-change-me-please-32-chars-min"
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL="info"
TZ_DEFAULT="Asia/Yekaterinburg"
STORAGE_DIR="./var/storage"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Интеграции (SYNC-04, A19/A45) -----------------------------------------
# Токен для приёма данных от 1С и почтового приёмника. В production обязателен.
INTEGRATION_TOKEN="dev-integration-token"
# Адрес транспорта почты. Пока не задан, письма остаются в очереди QUEUED
# и повторы не тратятся — система не показывает ложный SENT.
MAIL_TRANSPORT_URL=""
# Адрес приёмника событий 1С. Пока не задан, события остаются в PENDING.
OUTBOX_TARGET_URL=""

# --- Воркер доставки очередей (A19/A45) ------------------------------------
DELIVERY_INTERVAL_MS=30000
DELIVERY_TIMEOUT_MS=15000
# Первая повторная попытка; далее экспоненциально с ростом до часа.
DELIVERY_BACKOFF_BASE_MS=60000

# --- Ограничения и защита (SEC-01, API-01, API-02) --------------------------
JWT_TTL_SECONDS=43200
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_MAX=1200
# Жёсткий лимит именно на вход: smoke/нагрузочные прогоны делают много попыток.
AUTH_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_IMPORT_ROWS=5000
MAX_UPLOAD_BYTES=26214400

# --- Свежесть платёжных данных (SYNC-06) ------------------------------------
PAYMENT_DATA_FRESHNESS_MIN=120